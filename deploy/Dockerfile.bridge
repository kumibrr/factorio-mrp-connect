ARG PYTHON_IMAGE=python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_ROOT_USER_ACTION=ignore \
    PYTHONPATH=/app/src
COPY bridge/requirements.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock \
    && useradd --uid 10001 --create-home bridge \
    && mkdir -p /var/lib/factorio-bridge \
    && chown bridge:bridge /var/lib/factorio-bridge
COPY bridge/src /app/src
USER bridge
ENTRYPOINT ["python", "-m", "factorio_bridge"]
