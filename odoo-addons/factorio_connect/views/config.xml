<odoo>
  <record id="view_config_list" model="ir.ui.view">
    <field name="name">factorio.integration.config.list</field>
    <field name="model">factorio.integration.config</field>
    <field name="arch" type="xml"><list><field name="company_id"/><field name="warehouse_id"/><field name="enabled"/></list></field>
  </record>
  <record id="view_config_form" model="ir.ui.view">
    <field name="name">factorio.integration.config.form</field>
    <field name="model">factorio.integration.config</field>
    <field name="arch" type="xml"><form><sheet><group>
      <field name="company_id"/><field name="warehouse_id" domain="[('company_id', '=', company_id)]"/>
      <field name="source_id"/><field name="enabled"/><field name="terminal_days"/>
      <field name="odoo_base_url"/><field name="webhook_url" groups="base.group_system"/>
    </group></sheet></form></field>
  </record>
  <record id="action_config" model="ir.actions.act_window">
    <field name="name">Factory Integration</field><field name="res_model">factorio.integration.config</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_config" name="Factory Integration" parent="base.menu_administration" action="action_config" groups="base.group_system"/>
</odoo>
