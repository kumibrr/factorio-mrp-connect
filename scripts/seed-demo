#!/usr/bin/env python3
"""Seed/verify this project's demo using real workflow actions, never reset."""
import argparse
import os
import sys

from demo_common import compose, environment, pins, run, state_path

SHELL = '''
import json
import os
from dataclasses import asdict
from datetime import datetime, timezone
from odoo.addons.factorio_connect_demo.seed.service import seed_demo, verify_demo
if env.cr.dbname != 'factorio_demo':
    raise RuntimeError('seed-demo targets only factorio_demo')
mode = os.environ['FACTORIO_SEED_MODE']
try:
    if mode == 'seed':
        report = seed_demo(env, now=datetime.now(timezone.utc))
        env.cr.commit()
    else:
        env.cr.execute('SET TRANSACTION READ ONLY')
        report = verify_demo(env, baseline=mode == '--verify-baseline')
        env.cr.rollback()
    print(json.dumps(asdict(report), sort_keys=True))
except Exception:
    env.cr.rollback()
    raise
'''


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument('--verify', action='store_true')
    modes.add_argument('--verify-baseline', action='store_true')
    args = parser.parse_args()
    state = state_path()
    try:
        env = environment(state) if state.exists() else dict(os.environ, **pins())
        if not env.get('POSTGRES_PASSWORD'):
            raise ValueError('bootstrap first or provide local database credential')
        if (state / 'odoo.conf').exists():
            env['ODOO_CONFIG_FILE'] = str(state / 'odoo.conf')
        mode = '--verify-baseline' if args.verify_baseline else '--verify' if args.verify else 'seed'
        output = run(compose(env) + ['exec', '-T', '-e', 'FACTORIO_SEED_MODE=' + mode, 'odoo', '/entrypoint.sh', 'odoo', 'shell', '-d', 'factorio_demo', '--no-http'], environment=env, input=SHELL)
        print(output.strip())
    except (ValueError, RuntimeError, OSError) as error:
        print('Seed stopped: ' + str(error), file=sys.stderr)
        raise SystemExit(2) from None


if __name__ == '__main__':
    main()
