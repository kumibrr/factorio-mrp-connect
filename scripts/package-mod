#!/usr/bin/env python3
"""Deterministic runtime-only Factorio zip; never install into a game directory."""
import argparse
import json
from pathlib import Path
import zipfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output-dir', type=Path, default=Path(__file__).resolve().parents[1] / 'dist')
    args = parser.parse_args()
    source = Path(__file__).resolve().parents[1] / 'factorio-mod'
    info = json.loads((source / 'info.json').read_text())
    root = info['name'] + '_' + info['version']
    files = [source / name for name in ('info.json', 'control.lua', 'data.lua', 'settings.lua')]
    for directory in ('scripts', 'prototypes', 'locale'):
        files += [file for file in (source / directory).rglob('*') if file.is_file() and file.suffix in ('.lua', '.cfg')]
    args.output_dir.mkdir(parents=True, exist_ok=True)
    destination = args.output_dir / (root + '.zip')
    with zipfile.ZipFile(destination, 'w', compression=zipfile.ZIP_STORED) as archive:
        for file in sorted(files):
            if file.is_symlink():
                raise ValueError('runtime assets must not be symlinks')
            entry = zipfile.ZipInfo(root + '/' + file.relative_to(source).as_posix(), date_time=(1980, 1, 1, 0, 0, 0))
            entry.external_attr = 0o100644 << 16
            entry.compress_type = zipfile.ZIP_STORED
            archive.writestr(entry, file.read_bytes())
    print('Packaged ' + destination.name + ' (runtime assets only)')


if __name__ == '__main__':
    main()
