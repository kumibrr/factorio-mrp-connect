#!/usr/bin/env python3
"""Run only isolated --create/--benchmark fixtures with Factorio 2.0.77."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess
import tempfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--binary', type=Path, default=Path('/tmp/factorio-connect-2.0.77/factorio/bin/x64/factorio'))
    parser.add_argument('--artifacts', type=Path)
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    binary = args.binary.resolve()
    version = subprocess.run([str(binary), '--version'], check=True, capture_output=True, text=True).stdout
    if 'Version: 2.0.77 ' not in version:
        parser.error('This fixture requires the pinned Factorio 2.0.77 executable')
    parent = args.artifacts or root / 'runtime'
    parent.mkdir(parents=True, exist_ok=True)
    artifacts = Path(tempfile.mkdtemp(prefix='surface-smoke-', dir=parent.resolve()))
    mods = artifacts / 'mods'
    mods.mkdir()
    (mods / 'mod-list.json').write_text(json.dumps({'mods': [
        {'name': name, 'enabled': name in {'base', 'factorio-connect', 'factorio-connect-surface-smoke'}}
        for name in ['base', 'factorio-connect', 'factorio-connect-surface-smoke', 'space-age', 'quality', 'elevated-rails']
    ]}))
    shutil.copytree(root / 'factorio-mod', mods / 'factorio-connect_0.1.0', ignore=shutil.ignore_patterns('tests'))
    fixture = mods / 'factorio-connect-surface-smoke_0.1.0'
    shutil.copytree(root / 'factorio-mod/tests/engine/surface-smoke', fixture)
    snapshot = (root / 'contracts/fixtures/pumpworks-v1.json').read_text()
    (fixture / 'fixture.lua').write_text('return [====[' + snapshot + ']====]\n')
    config = artifacts / 'config.ini'
    config.write_text('[path]\nread-data=' + str(binary.parents[2] / 'data') + '\nwrite-data=' + str(artifacts / 'user-data') + '\n')
    save = artifacts / 'surface-smoke.zip'
    shared = ['--mod-directory', str(mods), '--config', str(config)]
    reports = []
    for label, command in [('create', ['--create', str(save)]), ('load-1', ['--benchmark', str(save), '--benchmark-ticks', '2']), ('load-2', ['--benchmark', str(save), '--benchmark-ticks', '2'])]:
        result = subprocess.run([str(binary), *command, *shared], capture_output=True, text=True, timeout=60)
        output = result.stdout + result.stderr
        (artifacts / (label + '.log')).write_text(output)
        if result.returncode:
            print(output[-6000:])
            raise SystemExit(f'Factorio surface fixture failed during {label}; artifacts: {artifacts}')
        found = [json.loads(line.split('FC_SURFACE_SMOKE ', 1)[1]) for line in output.splitlines() if 'FC_SURFACE_SMOKE ' in line]
        if not found or (label != 'create' and not found[-1]['save_load']):
            raise SystemExit(f'Missing engine evidence during {label}; artifacts: {artifacts}')
        reports.append({'run': label, **found[-1]})
    (artifacts / 'report.json').write_text(json.dumps(reports, indent=2) + '\n')
    print('Factorio 2.0.77: prototype creation, protected owned displays, native rendering, rename/idempotence, unrelated-entity preservation and two save loads passed; GUI not executed.')
    print(f'Artifacts: {artifacts}')


if __name__ == '__main__':
    main()
