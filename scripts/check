#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# This file contains only committed, nonsecret image/version pins.
source "$repo_root/deploy/versions.env"
mode=${1:-}
if [[ "$mode" == factorio ]]; then
  shift
  exec "$repo_root/scripts/check-factorio-surface" "$@"
fi
if [[ "$mode" == odoo ]]; then
  shift
  exec python3 "$repo_root/scripts/check-odoo" "$@"
fi
if [[ "$mode" != bridge && "$mode" != lua && "$mode" != e2e ]]; then
  echo 'Usage: ./scripts/check bridge [pytest-arguments...] | e2e [pytest-arguments...] | lua | odoo --tags TAGS | factorio --binary PATH' >&2
  exit 2
fi
shift
build_key=$(cat "$repo_root/deploy/Dockerfile.tests" "$repo_root/bridge/requirements-dev.lock" "$repo_root/deploy/versions.env" | sha256sum | cut -c1-20)
image_tag="factorio-connect-tests:$build_key"
if ! docker image inspect "$image_tag" >/dev/null 2>&1; then
  docker build --build-arg "PYTHON_IMAGE=$PYTHON_IMAGE" -f "$repo_root/deploy/Dockerfile.tests" -t "$image_tag" "$repo_root" >&2
fi
# Resolve the local immutable image ID before running; never execute a moving tag.
image_id=$(docker image inspect --format '{{.Id}}' "$image_tag")
runner=()
if [[ "$mode" == e2e ]]; then
  mkdir -p "$repo_root/runtime"
  config_file=$(mktemp "$repo_root/runtime/compose-config-XXXXXX.json")
  trap 'rm -f "$config_file"' EXIT
  export ODOO_IMAGE POSTGRES_IMAGE PYTHON_IMAGE POSTGRES_PASSWORD=nonsecret-contract-password
  export FACTORIO_STATE_DIR=/nonexistent/factorio-connect-contract
  export ODOO_HTTP_PORT=8069 ODOO_SUBNET=172.28.0.0/24 ODOO_GATEWAY=172.28.0.1
  export BRIDGE_HTTP_PORT=8765 BRIDGE_UDP_PORT=34200 GAME_UDP_PORT=34199
  unset ODOO_CONFIG_FILE
  docker compose -p factorio-connect --profile bridge -f "$repo_root/deploy/compose.yaml" config --format json > "$config_file"
  chmod 644 "$config_file"
  smoke_runner=()
  # Named setup/reset-only files are intentionally offline focused regressions.
  # Default/full e2e and every live/outage selection freshly run native evidence.
  offline_selection=false
  full_selection=false
  for selection in "$@"; do
    case "$selection" in
      tests/e2e/test_setup.py|tests/e2e/test_reset_contract.py) offline_selection=true ;;
      tests/*) full_selection=true ;;
    esac
  done
  if [[ "$offline_selection" == false || "$full_selection" == true ]]; then
    smoke_file=$(mktemp "$repo_root/runtime/smoke-report-XXXXXX.json")
    "$repo_root/scripts/smoke-demo" --isolated-test --output "$smoke_file"
    chmod 644 "$smoke_file"  # Secret-free metadata, readable by the isolated pytest UID.
    smoke_runner=(-e "FACTORIO_SMOKE_REPORT=/repo/runtime/$(basename "$smoke_file")")
  fi
  if [[ $# == 0 ]]; then set -- tests/e2e; fi
  set -- -p no:cacheprovider "$@"
  runner=(--workdir /repo -e "FACTORIO_COMPOSE_CONFIG=/repo/runtime/$(basename "$config_file")" "${smoke_runner[@]}")
fi
if [[ "$mode" == lua ]]; then runner=(--entrypoint lua5.2); set -- /repo/factorio-mod/tests/lua/run.lua "$@"; fi
docker run --rm --network none --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m "${runner[@]}" \
  --user "$(id -u):$(id -g)" -v "$repo_root:/repo:ro" "$image_id" "$@"
