ARG PYTHON_IMAGE=python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_ROOT_USER_ACTION=ignore
RUN apt-get update -qq && apt-get install -y --no-install-recommends lua5.2=5.2.4-3 lua-cjson=2.1.0+dfsg-2.2 && rm -rf /var/lib/apt/lists/*
COPY bridge/requirements-dev.lock /tmp/requirements-dev.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements-dev.lock
WORKDIR /repo/bridge
ENTRYPOINT ["python", "-m", "pytest"]
